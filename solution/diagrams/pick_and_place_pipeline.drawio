<mxfile host="app.diagrams.net" modified="2026-11-15T14:10:00.000Z" agent="Antigravity" version="24.7.17">
  <diagram id="pnp_1" name="Pick &amp; Place Pipeline">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="phase1" value="1. HOVER&#xa;Position hand 5cm above ring&#xa;Wrist vertical (cosine &gt; 0.98)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="2. DESCEND&#xa;Min-jerk chord down to ring&#xa;Finger gap open to 135 mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="3. CLOSE &amp; WELD&#xa;Close jaws, detect contact&#xa;Engage equality constraint&#xa;Freeze weld relative pose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase4" value="4. LIFT&#xa;Straight vertical climb&#xa;Raise ring clear of kit tray&#xa;(Z_ring &gt;= 0.93m)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase5" value="5. CARRY &amp; LEAD&#xa;Track moving bottle at v=33mm/s&#xa;Lead-time lookahead = 60ms&#xa;Interpolate to bottle neck center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="60" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="phase6" value="6. LOWER ON CONE&#xa;Descend ring over bottle neck&#xa;Servo ring body (not fingertip)&#xa;Align concentric with cone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="180" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase7" value="7. SETTLE ON SHOULDER&#xa;Rest on frustum (z in [130,136]mm)&#xa;Verify live radial error &lt; 2.2mm&#xa;Check ring uprightness &gt; 0.94" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase8" value="8. SAFE FINGER RELEASE&#xa;Open jaws while weld still active&#xa;WAIT until finger gap &gt; 90 mm&#xa;Drop weld only with ZERO contact&#xa;Eliminates 33 deg cocking!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="170" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="phase9" value="9. VERTICAL RETREAT&#xa;Climb vertically to RETREAT_Z&#xa;Emit ASSEMBLY_DONE to PLC&#xa;Ring stable on shoulder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="success" value="INSPECTION PASS&#xa;Radial &lt;= 4mm&#xa;Tilt = 0.000 rad&#xa;Hold &gt;= 0.50 s" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="175" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ep1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase1" target="phase2" />
        <mxCell id="ep2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase2" target="phase3" />
        <mxCell id="ep3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase3" target="phase4" />
        <mxCell id="ep4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase4" target="phase5" />
        <mxCell id="ep5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase5" target="phase6" />
        <mxCell id="ep6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase6" target="phase7" />
        <mxCell id="ep7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase7" target="phase8" />
        <mxCell id="ep8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase8" target="phase9" />
        <mxCell id="ep9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase9" target="success" />
      </root>
