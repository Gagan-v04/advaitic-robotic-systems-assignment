<mxfile host="app.diagrams.net" modified="2026-11-15T14:10:00.000Z" agent="Antigravity" version="24.7.17">
  <diagram id="pnp_1" name="Pick &amp; Place Pipeline">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="phase1" value="1. HOVER&#xa;HOVER_Z = GRASP_Z + 85 mm&#xa;Advance: err &lt; 35 mm, tool-down &gt; 0.88" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="2. DESCEND&#xa;Track the encoder + 5x5 ray target&#xa;err &lt; 30 mm, tool-down &gt; 0.92" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="3. CLOSE AND WELD&#xa;After 0.30 s, gap &lt; 0.12, tool-down &gt; 0.90&#xa;Engage if ring &lt; 16 mm and gap &lt; 0.11 m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase4" value="4. LIFT&#xa;Straight up to 0.968 m, XY frozen&#xa;Ring z &gt;= ring centre + 30 mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase5" value="5. CARRY&#xa;Wait on a column, 80 ms lead&#xa;Go when bottle x &gt;= -0.08 m (A) or -0.084 m (B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="60" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="phase6" value="6. LOWER&#xa;Uses plant arrival time and ring xpos&#xa;Radial &lt; 10 mm, z 128-145 mm, ring-up &gt; 0.90" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="180" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase7" value="7. SETTLE&#xa;Integral trim, gain 0.05 (A) or 0.08 (B)&#xa;Open when radial &lt; 3.6 mm and ring-up &gt; 0.94" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="phase8" value="8. OPEN&#xa;Jaws open while the weld still holds&#xa;Release when gap &gt; 0.090 m and seat gates pass&#xa;Fallbacks at 2.2 s and 2.8 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="170" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="phase9" value="9. RETREAT&#xa;Climb to 1.005 m at 0.45 m/s&#xa;ASSEMBLY_DONE after 0.05 s&#xa;Robot claim, not the accepted count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="success" value="PLANT INSPECTION&#xa;Radial &lt;= 4 mm, z 130-136 mm&#xa;Tilt &lt;= 10 deg, hold &gt;= 0.5 s&#xa;Independent of ASSEMBLY_DONE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="175" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ep1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase1" target="phase2" />
        <mxCell id="ep2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase2" target="phase3" />
        <mxCell id="ep3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase3" target="phase4" />
        <mxCell id="ep4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase4" target="phase5" />
        <mxCell id="ep5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase5" target="phase6" />
        <mxCell id="ep6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase6" target="phase7" />
        <mxCell id="ep7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase7" target="phase8" />
        <mxCell id="ep8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase8" target="phase9" />
        <mxCell id="ep9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="phase9" target="success" />
      </root>
    </mxGraphModel>
  </diagram>
