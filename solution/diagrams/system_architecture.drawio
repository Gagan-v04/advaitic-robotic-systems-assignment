          <mxGeometry x="20" y="40" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="feeder" value="Kit Feeder (Bottle + Rigid Ring)&#xa;Pitch = 450 mm, Arrival X = -300 mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="box_plant">
          <mxGeometry x="20" y="105" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inspect" value="Downstream Inspection Gate (X = +550 mm)&#xa;Radial &lt;= 4mm, Z in [130, 136]mm&#xa;Tilt &lt;= 10 deg, Settled Hold &gt;= 0.5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="box_plant">
          <mxGeometry x="20" y="170" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="plc_srv" value="Modbus/TCP Line Controller (Port 1502)&#xa;FC03 Read Accepts / FC16 Write Ready/Done&#xa;Idempotent Sequence Numbers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="box_plant">
          <mxGeometry x="20" y="250" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="belt_b" value="Conveyor B (yaw pi, -X travel)&#xa;Same speed. Silent until A has 5 accepts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="box_plant">
          <mxGeometry x="20" y="320" width="280" height="30" as="geometry" />
        </mxCell>

